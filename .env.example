LANGSMITH_PROJECT="banking-concierge"
LANGSMITH_TRACING="true"

LANGSMITH_WORKSPACE_ID=""
LANGSMITH_API_KEY=""
BASE_URL="https://gateway.smith.langchain.com/openai/v1"

OPENAI_API_KEY=""

# Optional override; defaults to gpt-4o-mini for the agent
CONCIERGE_MODEL="gpt-4o-mini"

# Anthropic-only gateway: use BASE_URL=https://gateway.smith.langchain.com/v1,
# CONCIERGE_MODEL=anthropic/claude-sonnet-5-5, and the same model for JUDGE_MODEL.
JUDGE_MODEL="gpt-4o"
# keyword uses local BM25 search and needs no embeddings provider.
CONCIERGE_RETRIEVAL="embeddings"
# Optional cloud runtime alias for the gateway and Context Hub credentials.
CONCIERGE_GATEWAY_API_KEY=${LANGSMITH_API_KEY}

# Only needed for scripts/load_generation.py --mode remote
LANGGRAPH_DEPLOYMENT_URL=""
